@page "/productos"
@inject ProductoService ProductoService


<h3>Productos</h3>

<AdminGuard>

<a href="/productos/nuevo" class="btn btn-primary mb-3">Crear producto</a>

@if (productos is null)
{
    <p>Cargando...</p>
}
else if (productos.Count == 0)
{
    <p>Todavía no hay productos cargados</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in productos)
            {
                <tr>
                    <td>
                        @if (p.ImagenUrl is not null)
                         {
                            <img src="@p.ImagenUrl" alt="@p.Nombre" style="height:50px" />
                         }
                   </td>
                    <td>@p.Nombre</td>
                    <td>@p.Precio.ToString("C")</td>
                    <td>@p.Stock</td>
                    <td>
                         <a href="/productos/editar/@p.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                         <a href="/productos/eliminar/@p.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
</AdminGuard>

@code {
    private List<Producto>? productos;

    protected override async Task OnInitializedAsync()
    {
        productos = await ProductoService.Listar();
    }
}