@page "/clientes"
@inject ClienteService ClienteService

<PageTitle>Clientes</PageTitle>

<AdminGuard>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Clientes</h1>
        <a class="btn btn-primary" href="clientes/nuevo">Nuevo cliente</a>
    </div>

    @if (error != null)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (clientes == null)
    {
        <p>Cargando...</p>
    }
    else if (clientes.Count == 0)
    {
        <div class="alert alert-info">Todavía no hay clientes cargados.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in clientes)
                {
                    <tr>
                        <td>@c.Nombre</td>
                        <td>@c.Telefono</td>
                        <td>@c.Direccion</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="clientes/editar/@c.Id">Editar</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(c.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AdminGuard>

@code {
    private List<Cliente>? clientes;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        clientes = await ClienteService.Listar();
    }

    private async Task Eliminar(int id)
    {
        error = null;
        try
        {
            await ClienteService.Eliminar(id);
            clientes = await ClienteService.Listar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}