@page "/pedidos"
@inject VentaService VentaService

<h3>Pedidos</h3>

<AdminGuard>
    @if (ventas is null)
    {
        <p>Cargando...</p>
    }
    else if (ventas.Count == 0)
    {
        <p>Todavía no hay pedidos</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>N°</th>
                    <th>Fecha</th>
                    <th>Cliente</th>                   
                    <th>Entrega</th>
                    <th>Pago</th>
                    <th>Estado</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in ventas)
                {
                    <tr>
                        <td>@v.Id</td>
                        <td>@v.Fecha.AddHours(-3).ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@v.Cliente?.Nombre</td>
                        <td>@v.TipoEntrega</td>
                        <td>@v.MetodoPago</td>
                        <td>@v.Estado</td>
                        <td>@v.Total.ToString("C")</td>
                        <td><a href="/pedidos/@v.Id" class="btn btn-sm btn-outline-primary">Ver</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AdminGuard>

@code {
    private List<Venta>? ventas;

    protected override async Task OnInitializedAsync()
    {
        ventas = await VentaService.Listar();
    }
}